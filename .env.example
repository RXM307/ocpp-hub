# --- OCPP listener ---
OCPP_PORT=9000
# Optional HTTP Basic password the charger must send (OCPP security profile 1). Empty = no auth.
OCPP_PASSWORD=
# If the charger's URL doesn't contain a usable station id, force one here.
FORCE_STATION_ID=

# --- MQTT (Home Assistant's broker) ---
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=ocpp
HA_DISCOVERY_PREFIX=homeassistant

# --- Behaviour ---
LOG_LEVEL=DEBUG            # DEBUG logs every raw OCPP frame; drop to INFO once it works
HEARTBEAT_INTERVAL=300
METER_INTERVAL=30          # seconds between MeterValues (pushed to charger on boot)
AUTO_CONFIGURE=true        # push MeterValues config to the charger after BootNotification
AUTO_AUTHORIZE=true        # accept any idTag (home use). false = only DEFAULT_ID_TAG + ALLOWED_ID_TAGS
DEFAULT_ID_TAG=HOMEASSISTANT
ALLOWED_ID_TAGS=
AUTO_START_ON_PLUG=false   # send RemoteStartTransaction when the car is plugged in (status Preparing)
MIN_CURRENT=6
MAX_CURRENT=32
PROFILE_PURPOSE=TxDefaultProfile   # or ChargePointMaxProfile if the charger rejects it
PROFILE_CONNECTOR=1                # some chargers want 0 for ChargePointMaxProfile
WS_PING_INTERVAL=60

# Settings pushed to the charger on connect (comma separated Key=Value).
# Starcharge "Artemis" units reject RemoteStart while FreeCharging=1 ("FreeCharging mode is enabled").
FORCE_CONFIG=FreeCharging=0

# Delete charging profiles stored on the charger when it connects. A leftover TxDefaultProfile with a 0 A limit
# (installed by another system) makes the charger accept a start but never offer current.
CLEAR_PROFILES_ON_CONNECT=true
